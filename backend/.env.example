# Copy to backend/.env and fill in. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/apexrx
# Required: at least 32 random characters. This placeholder is REJECTED at
# startup on purpose. Generate your own (never reuse the production one):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE-ME-generate-with-python-secrets-token-urlsafe-48
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Server-side sessions: signed out after this long without user activity, and
# after SESSION_MAX_AGE_HOURS at the latest (see README, "Sessions").
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_MAX_AGE_HOURS=12

# Environment. Defaults to production; local development must opt in so the
# mock email provider and the /dev endpoints are never enabled by accident.
APP_ENV=development

# Email verification (see README, "Email verification"). Registering a pharmacy
# or supplier needs a verified account email.
# Development: the mock provider sends nothing; open your link from
# GET /dev/email/latest. In production "mock" is refused (503): set a real
# provider (HTTPS API; Render's free plan blocks SMTP).
EMAIL_PROVIDER=mock
# Production, the ApexRX Gmail account through the Gmail API (see README,
# "Email delivery with the Gmail API"; no password, gmail.send scope only):
# EMAIL_PROVIDER=gmail
# GMAIL_CLIENT_ID=replace-with-your-oauth-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=replace-with-your-oauth-client-secret
# GMAIL_REFRESH_TOKEN=replace-with-the-token-from-app.scripts.gmail_authorize
# EMAIL_FROM_ADDRESS=the-apexrx-account@gmail.com
# Alternatives (optional, need a domain): Resend (https://resend.com, sender on a domain verified there):
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=replace-with-your-resend-api-key
# Production, Brevo (https://www.brevo.com, a verified sender or domain):
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=replace-with-your-brevo-api-key
# EMAIL_FROM_ADDRESS=no-reply@your-domain.example
# EMAIL_FROM_NAME=ApexRX Smart
# Where verify-email.html is served (the link in the email). HTTPS in production.
FRONTEND_BASE_URL=http://127.0.0.1:5501
# EMAIL_VERIFICATION_REQUIRED=true
# EMAIL_VERIFICATION_TTL_MINUTES=1440
# EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# EMAIL_VERIFICATION_MAX_SENDS_PER_USER_PER_HOUR=5
# EMAIL_VERIFICATION_MAX_SENDS_PER_IP_PER_HOUR=20
# Staff invitations and password reset links.
# INVITATION_TTL_HOURS=72
# PASSWORD_RESET_TTL_MINUTES=60
# PASSWORD_RESET_MAX_PER_USER_PER_HOUR=3
# PASSWORD_RESET_MAX_PER_IP_PER_HOUR=10

# Phone numbers (business contact, future Mobile Money; not used for verification).
# PHONE_DEFAULT_REGION=RW
# PHONE_ALLOWED_REGIONS=RW

# Document storage: Supabase Storage (production). Leave these unset to keep
# files on the local disk during development. The key is server-side only.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SECRET_KEY=replace-with-the-supabase-secret-key
# SUPABASE_BUCKET_NAME=organization-documents
# DOCUMENT_STORAGE=auto   # auto | supabase | local

# Login throttling (defaults shown). Counters are per process with memory://;
# use a shared store such as redis://host:6379 when running several instances.
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_FAILURE_WINDOW_SECONDS=900
# RATE_LIMIT_STORAGE_URI=memory://
# DEVICE_TOKEN_MAX_AGE_DAYS=90
# Header with the real client IP. Leave UNSET unless tools/render-ip-check has
# shown that the proxy always overwrites it (clients can forge it otherwise).
# Never X-Forwarded-For.
# TRUSTED_CLIENT_IP_HEADER=

# Optional
# CORS_ORIGINS=http://127.0.0.1:5501,http://localhost:5501
# UPLOAD_DIR=uploads      # local document storage only
# MAX_UPLOAD_SIZE_BYTES=10485760
# DEFAULT_CURRENCY=RWF

# Tests only: a disposable database whose name ends in _test
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/apexrx_test
