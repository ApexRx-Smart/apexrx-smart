# Copy to backend/.env and fill in. Never commit the real .env.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/apexrx
# Required: at least 32 random characters. This placeholder is REJECTED at
# startup on purpose. Generate your own (never reuse the production one):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE-ME-generate-with-python-secrets-token-urlsafe-48
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment. Defaults to production; local development must opt in so the
# mock SMS provider and the /dev endpoints are never enabled by accident.
APP_ENV=development

# Phone verification by SMS one-time code (see README, "Phone verification").
# Development: the mock provider sends nothing; read your code from
# GET /dev/sms/latest. In production "mock" is refused (503) - configure a real
# provider adapter, or set PHONE_VERIFICATION_REQUIRED=false until you have one.
SMS_PROVIDER=mock
# PHONE_VERIFICATION_REQUIRED=true
# SMS_SENDER_ID=
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_SENDS_PER_PHONE_PER_HOUR=5
# OTP_MAX_SENDS_PER_USER_PER_HOUR=10
# OTP_MAX_SENDS_PER_IP_PER_HOUR=20
# PHONE_DEFAULT_REGION=RW
# PHONE_ALLOWED_REGIONS=RW
# A real provider's credentials go here once one is chosen (names depend on
# the adapter), e.g. SMS_<PROVIDER>_API_KEY=... Never commit real values.

# Document storage: Supabase Storage (production). Leave these unset to keep
# files on the local disk during development. The key is server-side only.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SECRET_KEY=replace-with-the-supabase-secret-key
# SUPABASE_BUCKET_NAME=organization-documents
# DOCUMENT_STORAGE=auto   # auto | supabase | local

# Login throttling (defaults shown). Counters are per process with memory://;
# use a shared store such as redis://host:6379 when running several instances.
# LOGIN_MAX_FAILURES_PER_ACCOUNT=5
# LOGIN_MAX_FAILURES_PER_IP=20
# LOGIN_FAILURE_WINDOW_SECONDS=900
# RATE_LIMIT_STORAGE_URI=memory://
# DEVICE_TOKEN_MAX_AGE_DAYS=90
# Header with the real client IP. Leave UNSET unless tools/render-ip-check has
# shown that the proxy always overwrites it (clients can forge it otherwise).
# Never X-Forwarded-For.
# TRUSTED_CLIENT_IP_HEADER=

# Optional
# CORS_ORIGINS=http://127.0.0.1:5501,http://localhost:5501
# UPLOAD_DIR=uploads      # local document storage only
# MAX_UPLOAD_SIZE_BYTES=10485760
# DEFAULT_CURRENCY=RWF

# Tests only: a disposable database whose name ends in _test
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/apexrx_test
